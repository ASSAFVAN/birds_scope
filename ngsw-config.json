{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/favicon.svg", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"],
        "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-reference",
      "urls": ["/api/taxonomy", "/api/countries"],
      "cacheConfig": { "strategy": "performance", "maxSize": 4, "maxAge": "1d" }
    },
    {
      "name": "api-observations",
      "urls": ["/api/observations/**"],
      "cacheConfig": { "strategy": "freshness", "timeout": "10s", "maxSize": 30, "maxAge": "3d" }
    }
  ]
}
