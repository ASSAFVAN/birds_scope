# Copy this file to .env and fill in your key. .env is git-ignored.
# Get a free key at https://ebird.org/api/keygen (requires an eBird account).
EBIRD_API_KEY=your-ebird-api-key-here

# Port for the Express API proxy (the Angular dev server proxies /api to it).
PORT=3000

# --- Optional tuning -------------------------------------------------------
# Days of recent observations to request (eBird allows 1-30).
RECENT_BACK_DAYS=10
# Max records per eBird request (eBird allows 1-10000).
EBIRD_MAX_RESULTS=5000
# Upstream timeout in milliseconds.
EBIRD_TIMEOUT_MS=15000
# How long the taxonomy is cached, in hours.
TAXONOMY_CACHE_HOURS=24
# Short-lived cache for identical observation queries, in seconds (0 = off).
OBSERVATIONS_CACHE_SECONDS=120
# Per-client request limit for the proxy.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=60
# Proxies in front of the server to trust for client IPs. Use 1 behind a hosting
# load balancer (Render, Railway, Fly.io, Heroku). Default: loopback.
# TRUST_PROXY=1
# Folder with the built Angular app to serve. Defaults to dist/birdscope/browser when it exists.
# STATIC_DIR=/path/to/dist/birdscope/browser
# Only needed if the frontend is served from a different origin than the API.
# CORS_ORIGIN=http://localhost:4200
